#!/bin/sh
# Pre-commit drift guard: blocks a commit whose staged changes touch canonical plugin-generation
# inputs (artifacts/, src/, package.json, forge-plugin/) if forge-plugin/ would no longer match what
# `build-plugin` currently generates from artifacts/. Installed automatically via `pnpm install`
# (see package.json's "prepare" script and core.hooksPath). See RELEASING.md for the release flow
# this backstops, and .forge/claude-code-plugin-distribution/design-f4.md for the full design.
set -e

staged=$(git diff --cached --name-only)

if ! printf '%s\n' "$staged" | grep -qE '^(artifacts/|src/|package\.json$|forge-plugin/|plugins/forge/|\.agents/plugins/marketplace\.json$)'; then
  exit 0
fi

pnpm run build

if ! node scripts/check-plugin-sync.mjs; then
  echo ""
  echo "Plugin packages are out of sync with artifacts/. Regenerate and stage them, then retry:"
  echo "  node bin/forge-ai.mjs build-plugin --target claude --source . --out forge-plugin --force"
  echo "  node bin/forge-ai.mjs build-plugin --target codex --source . --out plugins/forge --force"
  exit 1
fi

exit 0
